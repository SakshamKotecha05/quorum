# Copy to .env and fill in. .env is gitignored -- never commit a real key.
# Get a free key (no card) at https://console.groq.com/keys
GROQ_API_KEY=<paste-your-key-here>

# Tiers deliberately map to DIFFERENT models. Free-tier token budgets are per model
# per day (200k on Groq), so pointing every tier at one model races three roles for
# one daily budget and exhausts it mid-run.
QUORUM_MODEL_DEEP=openai/gpt-oss-120b
QUORUM_MODEL_MID=openai/gpt-oss-20b
QUORUM_MODEL_FAST=qwen/qwen3.6-27b

# Groq free tier reports 8000 tokens/minute; the code defaults to a conservative 6000.
QUORUM_ORG_TPM=8000

# Or point at any other OpenAI-compatible endpoint, e.g. a local Ollama:
# QUORUM_BASE_URL=http://localhost:11434/v1
